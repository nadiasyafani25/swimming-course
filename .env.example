# Salin file ini jadi .env.local, lalu isi dengan nilai aslimu.
#
# .env.local sudah masuk .gitignore dan tidak akan pernah ikut ter-push.
# JANGAN pernah menulis kredensial asli di file ini.

# ---------------------------------------------------------------- database

# Dari Neon Dashboard > Connection Strings > "Pooled connection".
# Dipakai aplikasi saat runtime lewat src/db/index.ts.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Dari Neon Dashboard > Connection Strings > "Direct connection".
# Dipakai drizzle-kit untuk migrasi (drizzle.config.ts) dan script seed.
# Bukan wajib: kalau kosong, drizzle.config.ts memakai DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Nama branch Neon yang sedang dipakai. Opsional, hanya untuk perkakas Neon CLI.
NEON_BRANCH="production"

# ---------------------------------------------------------------- data seed

# Nama pelatih yang ditulis ke tabel coaches dan courses.coach_name
# saat menjalankan `npm run db:seed`.
#
# Nilai aslinya disimpan di .env.local, bukan di repo, supaya halaman
# /pelatih dan isi database tetap sinkron tanpa perlu nama itu ikut ter-push.
COACH_NAME="Nama Pelatih Anda"
