# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# log dev lokal. Tidak pernah dipush: dev-register.log pernah memuat
# hash scrypt dan data registration dari pengujian.
*.log

# catatan progres pribadi, isinya kredensial akun test.
PROGRESS*.md

# mockup HTML statis untuk desain halaman. Tidak dirujuk build atau src/.
/prototype/

# .env.example tetap ikut meski ada pola .env* di atas.
!.env.example
